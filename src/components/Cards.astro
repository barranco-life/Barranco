---
import Photo from './Photo.astro';
export interface CardItem {
  href: string;
  kind: string;        // label shown above the title
  kindClass?: string;  // colour class, e.g. 'kind-music'
  title: string;
  text: string;
  image?: string;      // path under public/
  alt?: string;
  art?: string;        // short word shown when there is no photo
  external?: boolean;
}
// level: the card titles' heading level; 2 when the list comes straight after the page's h1.
interface Props { items: CardItem[]; level?: 2 | 3 }
const { items, level = 3 } = Astro.props;
const H = `h${level}`;
---
<ul class="cards">
  {items.map((c) => (
    <li class={`card ${c.kindClass ?? ''}`}>
      {c.image
        ? <Photo src={c.image} alt={c.alt ?? ''} width={800} height={600} />
        : <div class="card__art" aria-hidden="true">{c.art}</div>}
      <div class="card__body">
        <p class="card__kind">{c.kind}</p>
        <H><a href={c.href} rel={c.external ? 'noopener' : undefined}>{c.title}</a></H>
        <p>{c.text}</p>
      </div>
    </li>
  ))}
</ul>
