---
import { asset } from '../i18n/site';
export interface CardItem {
  href: string;
  kind: string;        // label shown above the title
  kindClass?: string;  // colour class, e.g. 'kind-music'
  title: string;
  text: string;
  image?: string;      // path under public/
  alt?: string;
  art?: string;        // short word shown when there is no photo
  external?: boolean;
}
interface Props { items: CardItem[] }
const { items } = Astro.props;
---
<ul class="cards">
  {items.map((c) => (
    <li class={`card ${c.kindClass ?? ''}`}>
      {c.image
        ? <img src={asset(c.image)} alt={c.alt ?? ''} width="800" height="600" loading="lazy" />
        : <div class="card__art" aria-hidden="true">{c.art}</div>}
      <div class="card__body">
        <p class="card__kind">{c.kind}</p>
        <h3><a href={c.href} rel={c.external ? 'noopener' : undefined}>{c.title}</a></h3>
        <p>{c.text}</p>
      </div>
    </li>
  ))}
</ul>
