---
import { IG } from '../data/instagram';
import { LINKS, type Lang } from '../i18n/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const date = new Date(`${IG.updated}T12:00:00`).toLocaleDateString(lang === 'es' ? 'es-BO' : 'en-US', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const t = {
  es: { title: 'Lo último en Instagram', updated: `Última publicación: ${date}.`, all: 'Ver todo en Instagram', post: 'Ver la publicación en Instagram' },
  en: { title: 'Latest on Instagram', updated: `Latest post: ${date}.`, all: 'See everything on Instagram', post: 'See the post on Instagram' },
}[lang];
---
<section class="section section--band" id="agenda" aria-labelledby="agenda-title">
  <div class="wrap">
    <p class="eyebrow">@barranco.life</p>
    <h2 id="agenda-title">{t.title}</h2>
    <p class="muted">{t.updated} <a href={LINKS.instagram}>{t.all}</a></p>
    <div class="ig-grid">
      {IG.posts.map((url) => (
        <blockquote class="instagram-media" data-instgrm-permalink={url} data-instgrm-version="14">
          <a href={url}>{t.post}</a>
        </blockquote>
      ))}
    </div>
  </div>
</section>
<script is:inline>
  // Instagram's embed script is heavy and sets third-party cookies, so it loads only when the
  // feed comes near the screen. Until then each post is a plain link.
  (() => {
    const feed = document.getElementById('agenda');
    const load = () => {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.instagram.com/embed.js';
      document.body.append(s);
    };
    if (!feed || !('IntersectionObserver' in window)) return load();
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
    }, { rootMargin: '400px' });
    io.observe(feed);
  })();
</script>
