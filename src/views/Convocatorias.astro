---
import Base from '../layouts/Base.astro';
import Cards from '../components/Cards.astro';
import { href, wa, LINKS, type Lang } from '../i18n/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
// Keeps the path of the old barranco.life/convocatorias/. Forms kept next to WhatsApp (LC §20);
// workshop contribution formula from ER Projects/Barranco/Manuals/Talleres.md (public per Ernesto 2026-09-23).
const propose = wa('ernesto', es
  ? 'Hola, quiero proponer algo en el Barranco.\n\nQué es (concierto, taller, función, otra idea):\nQuién lo hace:\nFecha u horario aproximado:\nLink (Instagram, música, portafolio):'
  : 'Hi, I would like to propose something at Barranco.\n\nWhat it is (concert, workshop, screening, other idea):\nWho is doing it:\nApproximate date or time:\nLink (Instagram, music, portfolio):');
const c = es ? {
  title: 'Propón algo en el Barranco', description: 'Conciertos, funciones, talleres, exposiciones, encuentros o voluntariado: cómo proponer algo en el Barranco, en Mallasa.',
  lead: 'El Barranco se hace con la gente que llega con una idea. Si quieres tocar, proyectar, enseñar, exponer o celebrar aquí, este es el camino.',
  howT: 'Cómo lo conversamos', how: 'Cada propuesta se conversa caso por caso. Si va bien con el lugar, buscamos la forma. Si necesita ajustes, los decimos. Si no es buen momento o no encaja, también lo diremos con claridad.',
  tallT: 'Talleres y clases: el aporte al espacio',
  tall: 'Trabajamos con un aporte al espacio, no con un alquiler. Para talleres y actividades con cobro al público, el aporte es el mayor entre:',
  tallList: ['100 Bs por hasta 2 horas, más 50 Bs por cada hora adicional;', 'o el 20% de lo recaudado.'],
  tallExtras: 'Los extras (sonido, luces, proyector, apoyo técnico) se cotizan aparte. Para actividades gratuitas, comunitarias o muy alineadas con el espacio podemos evaluar un ajuste.',
  tallForm: 'Formulario de talleres o clases', whatsapp: 'Escribir por WhatsApp',
} : {
  title: 'Propose something at Barranco', description: 'Concerts, screenings, workshops, exhibitions, gatherings or volunteering: how to propose something at Barranco, in Mallasa.',
  lead: 'Barranco is made by the people who arrive with an idea. If you want to play, screen, teach, exhibit or celebrate here, this is the way.',
  howT: 'How we talk it through', how: 'Every proposal is discussed case by case. If it suits the place, we find a way. If it needs adjustments, we say so. If it is not the right moment or does not fit, we will say that clearly too.',
  tallT: 'Workshops and classes: the contribution to the space',
  tall: 'We work with a contribution to the space, not a rental. For workshops and activities that charge the public, the contribution is the greater of:',
  tallList: ['100 Bs for up to 2 hours, plus 50 Bs for each additional hour;', 'or 20% of what is collected.'],
  tallExtras: 'Extras (sound, lights, projector, technical support) are quoted separately. For free, community or especially aligned activities we can consider an adjustment.',
  tallForm: 'Workshop or class form', whatsapp: 'Message us on WhatsApp',
};
const cards = [
  { href: propose, kind: es ? 'Música · cine · talleres' : 'Music · cinema · workshops', title: es ? 'Un concierto, una función o un taller' : 'A concert, a screening or a workshop', text: es ? 'Cuéntanos quién eres, qué propones y cuándo.' : 'Tell us who you are, what you propose and when.' },
  { href: href(lang, 'galeria/'), kind: es ? 'Galería' : 'Gallery', kindClass: 'kind-gallery', title: es ? 'Una exposición' : 'An exhibition', text: es ? 'La galería recibe propuestas de artes visuales.' : 'The gallery welcomes visual arts proposals.' },
  { href: href(lang, 'encuentros/'), kind: es ? 'Encuentros' : 'Gatherings', kindClass: 'kind-gatherings', title: es ? 'Un encuentro de tu grupo' : 'A gathering for your group', text: es ? 'Cumpleaños, comidas, talleres o ideas que todavía no tienen nombre.' : 'Birthdays, meals, workshops or ideas that have no name yet.' },
  { href: LINKS.formEquipo, kind: es ? 'Equipo' : 'Team', title: es ? 'Ser parte del equipo' : 'Join the team', text: es ? 'Llena el formulario del equipo Barranco, o súmate al voluntariado.' : 'Fill in the Barranco team form, or join the volunteers.', external: true },
];
---
<Base lang={lang} path="convocatorias/" title={c.title} description={c.description}>
  <section class="page-head">
    <div class="wrap">
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <Cards items={cards.map((x) => ({ ...x, art: x.kind.split(' ')[0] }))} />
      <div class="prose" style="margin-top:32px">
        <h2>{c.howT}</h2>
        <p>{c.how}</p>
      </div>
    </div>
  </section>
  <section class="section section--band" id="talleres">
    <div class="wrap prose">
      <h2>{c.tallT}</h2>
      <p>{c.tall}</p>
      <ul>{c.tallList.map((x) => <li>{x}</li>)}</ul>
      <p>{c.tallExtras}</p>
      <div class="actions">
        <a class="button" href={LINKS.formTalleres}>{c.tallForm}</a>
        <a class="button button--ghost" href={propose}>{c.whatsapp}</a>
      </div>
    </div>
  </section>
</Base>
